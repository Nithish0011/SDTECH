{
  "name": "sdtech-recruitment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && wrangler pages deploy .vercel/output/static --project-name=sdtech",
    "db:migrate": "wrangler d1 execute recruitment-db --remote --file=./migrations/0001_schema.sql",
    "db:migrate:local": "wrangler d1 execute recruitment-db --local --file=./migrations/0001_schema.sql"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^5.0.0"
  }
}
